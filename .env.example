# ── Ollama / LLM ──────────────────────────────────────────────────────────────
# For local development:
OLLAMA_BASE_URL=http://localhost:11434

# For Google Colab + Pinggy (replace with your actual tunnel URL):
# OLLAMA_BASE_URL=http://<your-token>.a.free.pinggy.link

LLM_MODEL=gpt-oss:20b
LLM_TIMEOUT=120

# ── Intent model (Lab 2 fine-tuned checkpoint) ────────────────────────────────
# Set to the path of your fine-tuned model directory from Lab 2.
# If this path does not exist, the system falls back to keyword-based detection.
INTENT_MODEL_PATH=intent_model_checkpoint

# ── FastAPI server ─────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=true

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
